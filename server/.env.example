# Backend config — copy to server/.env and edit
PORT=5000
JWT_SECRET=replace-with-a-long-random-string

# SMTP for email (optional). Use a real provider with a verified sender.
# Gmail requires a Google app password here, not your regular Gmail password.
# Google app passwords are usually shown as 16 characters; spaces are OK.
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usgymnasium2021@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM="US Gymnasium <usgymnasium2021@gmail.com>"
SMTP_REPLY_TO=usgymnasium2021@gmail.com

# Gmail alternative:
# SMTP_SERVICE=gmail
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_PASS=your-16-character-google-app-password
# SMTP_FROM="US Gymnasium <your-gmail-address@gmail.com>"
# SMTP_REPLY_TO=your-gmail-address@gmail.com
